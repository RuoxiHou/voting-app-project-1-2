terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.60"
    }

    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }

    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }

    backend "s3" {
        key          = "terraform.tfstate"
        region       = var.aws_region
        encrypt      = true
        use_lockfile = true
    }
  }
}